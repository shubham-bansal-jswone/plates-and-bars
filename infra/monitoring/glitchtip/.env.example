# Copy to .env on the GlitchTip host (chmod 600) and fill in. Never commit .env. No value here is a real secret.

# Public host name (Caddy gets a Let's Encrypt certificate for it; DNS must point at this host). Also the host of the DSN.
GLITCHTIP_HOST=errors.example.com

# Generate each with: openssl rand -hex 32   (hex only: POSTGRES_PASSWORD is placed inside a URL)
SECRET_KEY=change-me-openssl-rand-hex-32-change-me-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24

# Alert e-mail: an SMTP account you already have
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=errors@example.com
