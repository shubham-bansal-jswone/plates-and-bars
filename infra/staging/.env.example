# Copy to .env on the VM (chmod 600) and fill in. Never commit .env. Values with spaces or $ need shell quoting
# because backup.sh sources this file.

# Public host name of the API (Caddy gets a Let's Encrypt certificate for it; DNS must point at the VM)
API_HOST=api.example.com

# Web app (#683): host name of the Expo web export, on the same site as API_HOST (for example app.example.com next
# to api.example.com), DNS pointing at this VM. Leave commented out until the web deploy is set up (RUNBOOK.md section 7).
# Put https://<WEB_HOST> in CORS_ALLOWED_ORIGINS below, and in AUTH_COOKIE_ORIGINS once the backend has it (#644).
#WEB_HOST=app.example.com
# Only if the web build has EXPO_PUBLIC_SENTRY_DSN: the origin of that DSN (scheme and host, no path), for the web CSP (#749).
# Must be a bare https origin (no path, no trailing slash, no wildcard): "https:" or "*" would open connect-src to any
# host. After editing, check the pair (it fails when a DSN is set and this is empty):
#   infra/scripts/check-sentry-origin.sh "$WEB_SENTRY_ORIGIN" "$EXPO_PUBLIC_SENTRY_DSN"
#WEB_SENTRY_ORIGIN=https://errors.example.com
# Directory on the VM that web-deploy.yml rsyncs into (default ./web next to this file)
#WEB_DIR=./web

# Image tag of the API build, e.g. the git sha. Kept here (not only exported) so a plain `docker compose up -d`
# always runs the tag that was built. Update and rollback change this line: see RUNBOOK.md.
API_TAG=local

# CONTENT_UPDATED_AT is not set here: export it only for `docker compose build api` (RUNBOOK.md).

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=plateandbar
DB_PASSWORD=change-me-db

# API (see backend/README.md, Environment variables)
JWT_SIGNING_KEY=change-me-at-least-32-bytes-long-secret
GOOGLE_CLIENT_IDS=
CORS_ALLOWED_ORIGINS=
# Exact origin(s) of the web app that may use the httpOnly refresh cookie (X-Auth-Transport: cookie), comma-separated,
# no '*', for example https://app.example.com. Separate from CORS_ALLOWED_ORIGINS; empty refuses cookie mode, so
# set it in production whenever the web app is served.
AUTH_COOKIE_ORIGINS=
# Most records one account may store (413 account_full beyond it). Empty or 0 = no cap; keep empty until the app handles account_full.
SYNC_MAX_RECORDS_PER_ACCOUNT=
# Barcode lookup through Open Food Facts (#944). Off by default. Turning it on needs OFF_CONTACT_EMAIL (it goes into the
# User-Agent, at most 100 printable ASCII characters): the API REFUSES TO START with OFF_ENABLED=true and an empty address.
# Owner steps first (OFF's API usage form, the address): RUNBOOK.md section 9. Leave OFF_BASE_URL unset (default https://world.openfoodfacts.org).
OFF_ENABLED=false
OFF_CONTACT_EMAIL=
#OFF_BASE_URL=https://world.openfoodfacts.org
# AI image calls (#946). Off by default. Do not enable before #990 (decode cap and memory limit) is merged and deployed, and a real
# provider is chosen (#926; until then every AI feature stays off whatever these say): RUNBOOK.md section 10.
AI_MEAL_PHOTO_ENABLED=false
AI_IMPORT_RECIPE_ENABLED=false
AI_FORM_CHECK_ENABLED=false
# Error tracking DSN for the API (Sentry SDK, sent to GlitchTip). Empty = off. Never commit a real DSN.
# The production .env MUST have SENTRY_ENVIRONMENT=production when SENTRY_DSN is set: release.sh refuses otherwise.
# API_RELEASE is written by deploy.sh next to API_TAG (the tag without its leading v); do not set it by hand.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Nightly backup (backup.sh): any S3-compatible bucket, for example Cloudflare R2 or MinIO.
# Endpoint for R2: https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=https://example.invalid
BACKUP_S3_BUCKET=plateandbar-backups
# Use a different prefix per stack (staging, production) so retention and restores never mix them
BACKUP_S3_PREFIX=staging
BACKUP_S3_ACCESS_KEY_ID=change-me
BACKUP_S3_SECRET_ACCESS_KEY=change-me
# Optional: backup.sh requests this URL after each successful backup (Uptime Kuma push monitor, heartbeat interval
# 25 hours). Single-quote the value: it contains &. Leave empty to switch it off. Treat it as a secret.
# BACKUP_HEARTBEAT_URL='https://<kuma-host>/api/push/<token>?status=up&msg=OK&ping='
BACKUP_HEARTBEAT_URL=
# Optional: ledger-upload.sh (hourly erasure-ledger upload, RUNBOOK.md section 3a) requests this URL after each successful
# run (Uptime Kuma push monitor, heartbeat interval about 2 hours). Single-quote the value. Empty = off. Treat it as a secret.
LEDGER_HEARTBEAT_URL=
# Optional: restore-check.sh (monthly restore rehearsal, RUNBOOK.md section 4) requests this URL after a successful run
# (Uptime Kuma push monitor, heartbeat interval about 32 days, so a skipped month alerts). Single-quote it; treat it as a secret.
RESTORE_HEARTBEAT_URL=
