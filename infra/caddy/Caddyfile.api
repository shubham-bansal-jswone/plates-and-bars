# Caddy (Apache-2.0) in front of the Plate & Bar API. Template: no hosting decision is made yet.
# Caddy obtains and renews the Let's Encrypt certificate itself (ports 80 and 443 must reach it).
# Validated in CI (caddy validate) on every change to this file.
#
# Environment (both have defaults so the file validates as is):
#   API_HOST      public host name of the API, e.g. api.example.com
#   API_UPSTREAM  address of the backend as Caddy reaches it, e.g. api:8080 (Compose service) or 127.0.0.1:8080
#
# Client IP and rate limits: Caddy's reverse_proxy replaces any X-Forwarded-For sent by the client with the real
# peer address (its own trusted_proxies is left empty on purpose: nothing sits in front of Caddy). The backend only
# believes X-Forwarded-For from peers listed in APP_RATELIMIT_TRUSTEDPROXIES, so set that on the API to the address
# the API sees Caddy connecting from, NOT to anything in this file:
#   - Caddy and API in one Compose network: that network's subnet, e.g. APP_RATELIMIT_TRUSTEDPROXIES=172.28.0.0/24
#     (infra/staging/docker-compose.yml pins that subnet).
#   - Caddy on the VM host, API published on 127.0.0.1:8080: the Docker bridge gateway, usually 172.17.0.1
#     (check with `docker network inspect bridge`), because the API sees the gateway as the peer.
#   - If a CDN or another proxy is ever placed in front of Caddy, add its ranges to the same variable.
# Left empty, every client shares the proxy's rate-limit buckets.
#
# Request body: the backend refuses bodies over SYNC_MAX_BODY_BYTES (default 2097152 = 2 MiB) with 400 too_large.
# The proxy limit below (4 MiB) sits above that so the backend's contract error is what clients see; Caddy's own
# 413 only stops bodies far past any valid request (the app treats 413 like too_large anyway). If you raise
# SYNC_MAX_BODY_BYTES, keep max_size above it.
{$API_HOST:api.example.com} {
	encode zstd gzip

	# Access log (#714), JSON, one file per host under /data (the caddy_data volume in the Compose stack). Privacy: the
	# client IP is masked to /24 (IPv4) or /48 (IPv6) in remote_ip, client_ip and remote_addr; the query string is cut
	# from the URI; every request header (Authorization, Cookie, X-Forwarded-For, User-Agent ...) and every response
	# header (Set-Cookie ...) is dropped; Caddy never logs request bodies. Kept 14 days (roll_keep_for 336h) and at most
	# 10 files of 10 MiB. infra/scripts/check-caddy-access-log.sh fails CI if one of these filters goes missing.
	log api_access {
		output file /data/api_access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format filter {
			wrap json
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>remote_addr ip_mask {
				ipv4 24
				ipv6 48
			}
			request>uri regexp "\?.*$" ""
			request>headers delete
			resp_headers delete
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}

	# Only the API is exposed; anything else (actuator, probes of other paths) never reaches the backend.
	handle /api/* {
		request_body {
			max_size 4MiB
		}
		reverse_proxy {$API_UPSTREAM:api:8080} {
			# Take the upstream out of rotation while /health is not 200 (503 = database unreachable).
			health_uri /api/v1/health
			health_interval 30s
			health_timeout 5s
			health_status 200
		}
	}
	handle {
		respond "not found" 404
	}
}
