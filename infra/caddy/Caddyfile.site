# Caddy (Apache-2.0) serving the static Astro build. Replace example.com.
# Caddy obtains and renews the Let's Encrypt certificate itself.
# The deploy workflow rsyncs apps/site/dist into /srv/site.
# The security headers below mirror apps/site/public/_headers (Cloudflare Pages format, which Caddy ignores).
# Keep them in step: infra/scripts/check-caddy-headers.sh fails CI when they drift.
# Validated in CI (caddy validate) on every change to this file.
{
	# Default log (#714): the site has no log directive, so Caddy's access and error lines (they carry the URI, the client IP and
	# the User-Agent) go to stderr through this filter: IP masked to /24 or /48, query cut, headers dropped.
	# infra/scripts/check-caddy-access-log.sh fails CI if one of these goes missing.
	log default {
		output stderr
		format filter {
			wrap json
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>uri regexp "\?.*$" ""
			request>headers delete
			resp_headers delete
		}
	}
}

example.com {
	root * /srv/site
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Astro writes content-hashed files to /_astro/: cache forever.
	# Everything else (HTML and unhashed files) must revalidate so a deploy shows up.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /_astro/*
	header @revalidate Cache-Control "no-cache"
}
