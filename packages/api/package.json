{
  "name": "@plate-and-bar/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Plate & Bar OpenAPI contract and generated TypeScript client",
  "type": "module",
  "main": "client/index.ts",
  "types": "client/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o client/schema.d.ts",
    "lint": "redocly lint openapi.yaml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test-vectors": "node test-vectors/verify.mjs",
    "check": "npm run lint && npm run generate && git diff --exit-code -- client/schema.d.ts && npm run typecheck && npm run test-vectors"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.63.0",
    "js-yaml": "5.4.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
