{
  "description": "Image rules of POST /ai/meal-photo, /ai/import-recipe and /ai/form-check (#946, ADR 008). Backend and app tests load this file. 'order' is the order the server checks one image in; the first fault wins and is the `details[].issue` of the 400. `verify.mjs` runs every case through a small reference checker and checks the limits against openapi.yaml.",
  "media_types": [
    "image/jpeg",
    "image/png"
  ],
  "max_decoded_bytes": {
    "photo": 1200000,
    "frame": 350000
  },
  "max_side_px": 4096,
  "max_megapixels": 16,
  "frames": {
    "min": 2,
    "max": 4
  },
  "body_limit_bytes": 2097152,
  "reencode": {
    "format": "image/jpeg",
    "max_long_side_px": 1600
  },
  "order": [
    "unsupported_type",
    "invalid_base64",
    "too_large",
    "type_mismatch",
    "dimensions",
    "unreadable_image"
  ],
