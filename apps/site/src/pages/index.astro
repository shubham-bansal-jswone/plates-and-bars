---
import Base from "../layouts/Base.astro";
---

<Base landing title="Plate & Bar" description="Plate & Bar helps you log meals and workouts and see your daily targets in one place.">
  <section class="band band-black hero">
    <div class="wrap">
      <h1>Plate &amp; Bar</h1>
      <p class="lede">Log your meals and workouts, and see your daily targets in one place.</p>
      <p><span class="badge">Coming to Android and web</span></p>
    </div>
  </section>

  <section class="band band-white" aria-labelledby="what">
    <div class="wrap">
      <h2 id="what">What the app does</h2>
      <ul class="cards">
        <li><strong>Daily targets</strong>Calories, protein, carbs and fat calculated from the details you enter.</li>
        <li><strong>Meal logging</strong>Add foods to each meal and see your plate fill up through the day.</li>
        <li><strong>Workout logging</strong>Record exercises, sets and weights, and keep your history.</li>
        <li><strong>Works offline</strong>Everything is saved on your phone first and syncs when you are online.</li>
      </ul>
      <p class="note">Plate &amp; Bar is a tracking tool. It does not provide medical advice.</p>
    </div>
  </section>

  <section class="band band-blue cta" aria-labelledby="soon">
    <div class="wrap">
      <h2 id="soon">How we handle your data</h2>
      <p>The privacy policy is a draft, pending lawyer review.</p>
      <a class="btn btn-ghost" href="/privacy/">Read the draft privacy policy</a>
    </div>
  </section>
</Base>
