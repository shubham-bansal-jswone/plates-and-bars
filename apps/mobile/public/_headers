# Cloudflare Pages: copied into dist/ by `npx expo export --platform web`.
# expo-sqlite on web needs cross-origin isolation (SharedArrayBuffer).
# The CSP is the same as in infra/caddy/Caddyfile.web, where the API host and the error-tracking origin come from
# API_HOST and SENTRY_ORIGIN; here api.example.com stands for the API host and the error-tracking origin is left out.
# Pages cannot template it: edit the host if you use Pages. infra/scripts/check-caddy-headers.sh keeps the two in step.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.example.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
