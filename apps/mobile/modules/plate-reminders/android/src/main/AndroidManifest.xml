<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Runtime permission on Android 13+ (asked when the first reminder is switched on). No exact-alarm permission: the alarms are inexact. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver android:name="app.plateandbar.reminders.ReminderReceiver" android:exported="false" />
    <!-- Rest-timer notification (#1068): the end alarm and the +30 s / Skip rest buttons. Both are our own PendingIntents. -->
    <receiver android:name="app.plateandbar.reminders.RestAlertReceiver" android:exported="false" />
    <receiver android:name="app.plateandbar.reminders.RestActionReceiver" android:exported="false" />
    <!-- System broadcasts only (delivered to a non-exported receiver; any other action is ignored): re-arm after a reboot, an app update, or a clock or time zone change. -->
    <receiver android:name="app.plateandbar.reminders.RearmReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
