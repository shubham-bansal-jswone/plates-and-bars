{
  "name": "plates-and-bars-tools",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Content tooling: importers and validators. No runtime dependencies.",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "node lint.mjs",
    "test": "node --test test/*.test.mjs",
    "import:exercises": "node exercises-import/cli.mjs",
    "validate:exercises": "node validate/cli.mjs",
    "import:figures": "node exercise-figures/cli.mjs",
    "check:figures": "node exercise-figures/cli.mjs --check",
    "validate:exercise-images": "node validate/exercise-images-cli.mjs",
    "import:motion": "node exercise-motion/cli.mjs",
    "validate:exercise-motion": "node validate/exercise-motion-cli.mjs",
    "fixture:motion": "node exercise-motion/make-fixture.mjs",
    "import:foods": "node foods-import/cli.mjs",
    "validate:foods": "node validate/foods-cli.mjs",
    "validate:import-aliases": "node validate/import-aliases-cli.mjs",
    "validate:cards": "node validate/cards-cli.mjs",
    "validate:recipes": "node validate/recipes-cli.mjs",
    "validate:labs": "node validate/labs-cli.mjs",
    "check:sources": "node check-no-ifct/cli.mjs"
  }
}
